# Genizah — Digital Filing Cabinet
# Copy to .env and fill in values

# Server
PORT=3090
NODE_ENV=production

# JWT Auth (generate with: openssl rand -base64 40)
JWT_SECRET=0rFDNPdhsDr/SLqXGoo9ELaFpz9r+VQR24jH+AjGywV3cWsOBIBLcA==

# Authentik SSO (optional, leave blank to disable)
AUTHENTIK_ENABLED=false
AUTHENTIK_BASE_URL=https://auth.cookiebytestech.com
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=https://vault.cookiebytestech.com/auth/callback

# Sofer (Paperless-ngx) OCR
SOFER_BASE_URL=http://127.0.0.1:8010
SOFER_API_TOKEN=

# Ntfy (Qol) Notifications
NTFY_BASE_URL=http://127.0.0.1:8090
NTFY_TOPIC=genizah
NTFY_ENABLED=true

# File Storage
MAX_FILE_SIZE_MB=25
UPLOAD_PATH=/app/data/files
THUMBNAIL_PATH=/app/data/thumbnails
DB_PATH=/app/data/db/genizah.sqlite

# Google Drive Sync (handled by rclone cron, not the app directly)
# See /opt/genizah/config/rclone-sync.sh
